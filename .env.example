# Configure these variables in Qt Creator's Run Environment or your shell.
SECONDHAND_DB_HOST=127.0.0.1
SECONDHAND_DB_PORT=3306
SECONDHAND_DB_NAME=shop
SECONDHAND_DB_USER=root
SECONDHAND_DB_PASSWORD=replace_with_your_local_password

# Optional directory containing additional product images organised by category.
# The application uses bundled ui_assets when this is not set.
SECONDHAND_IMAGE_ROOT=
